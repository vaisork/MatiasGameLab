# Copy outside Git to /etc/vintage-telnet/server.env, root-owned mode 0600.
# Generate with: python3 -c 'import secrets; print(secrets.token_hex(32))'
VT_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
VT_DATA_DIR=/var/lib/vintage-telnet
VT_HOST=127.0.0.1
VT_PORT=8080
VT_TRUSTED_HOSTS=localhost,127.0.0.1
# 1 permits cookies on HTTP, only for the initial trusted LAN/loopback test.
# For HTTPS use 0. Never publish this HTTP listener to the Internet.
VT_ALLOW_HTTP=1
