# Copy outside Git to /etc/vintage-telnet/server.env, root-owned mode 0600.
# Generate with: python3 -c 'import secrets; print(secrets.token_hex(32))'
VT_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
VT_DATA_DIR=/var/lib/vintage-telnet
VT_HOST=127.0.0.1
VT_PORT=8080
VT_TRUSTED_HOSTS=localhost,127.0.0.1
# NPC conversations remain on the deterministic provider unless explicitly enabled.
VT_NPC_DIALOGUE_PROVIDER=fixed
# To use local Ollama for live NPC conversations, set provider=ollama and name
# an approved general model (e.g. llama3.2:3b). Do not select the Ojo de Agua
# fine-tune, and never expose Ollama outside loopback.
# VT_NPC_DIALOGUE_PROVIDER=ollama
# VT_OLLAMA_DIALOGUE_URL=http://127.0.0.1:11434
# VT_OLLAMA_DIALOGUE_MODEL=<approved-model>
# VT_OLLAMA_DIALOGUE_TIMEOUT=120
# 1 permits cookies on HTTP, only for the initial trusted LAN/loopback test.
# For HTTPS use 0. Never publish this HTTP listener to the Internet.
VT_ALLOW_HTTP=1

# Required for the Dungeon Master panel (/dm) to work at all. Without this,
# /dm is disabled by design (fails closed) and no account can ever be
# approved -- the P0 flow (enter -> approve -> pick species) cannot complete.
# Choose your own value; this is not a secret shipped with the repo.
VT_DM_PASSWORD=REPLACE_WITH_A_PASSWORD_ONLY_JAVIER_KNOWS
